<Window x:Class="EasySE.App.ExportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="导出 MP4" Icon="Assets/app.ico" Width="530" Height="420" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="WindowClosing" Background="#1c1b24">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><TextBlock x:Name="ResolutionText" Foreground="#bda2df"/><TextBlock Text="30 fps" Foreground="#bda2df" Margin="20,0"/><TextBlock Text="原始音频" Foreground="#bda2df"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,24,0,0"><TextBlock Text="文件名" Foreground="#a69ab8" Margin="0,0,0,9"/><TextBox x:Name="FileName" MaxLength="100" Height="36"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,20,0,0"><TextBlock Text="目标目录" Foreground="#a69ab8" Margin="0,0,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DirectoryPath" Height="36"/><Button x:Name="DirectoryButton" Grid.Column="1" Content="选择目录" Click="DirectoryClick" Margin="9,0,0,0"/></Grid></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,24,0,0"><Grid><TextBlock x:Name="Stage" Foreground="#b99adf"/><TextBlock x:Name="Percent" Foreground="#b99adf" HorizontalAlignment="Right"/></Grid><ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Foreground="#a78bfa" Background="#31253e" BorderThickness="0" Margin="0,10,0,0" Visibility="Collapsed"/></StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="取消" Click="CancelClick" MinWidth="80"/><Button x:Name="StartButton" Content="导出" Style="{StaticResource Primary}" Click="StartClick" MinWidth="80" Margin="9,0,0,0"/></StackPanel>
  </Grid>
</Window>
